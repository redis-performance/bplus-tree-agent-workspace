--- a/src/zset_btree.c
+++ b/src/zset_btree.c
@@ -3250,8 +3250,19 @@
     zbtScoreNode *node = &leaf->n;
     while (node->parent) {
         zbtScoreInner *parent = node->parent;
-        for (unsigned int i = 0; i < node->parent_index; i++)
-            rank += parent->child_count[i];
+        unsigned int idx = node->parent_index;
+        unsigned int count = parent->n.count;
+        if (idx <= (count - 1) / 2) {
+            const uint64_t *p = parent->child_count;
+            const uint64_t *end = p + idx;
+            while (p != end) rank += *p++;
+        } else {
+            uint64_t local = parent->n.subtree - node->subtree;
+            const uint64_t *p = parent->child_count + count;
+            const uint64_t *end = parent->child_count + idx + 1;
+            while (p != end) local -= *--p;
+            rank += local;
+        }
         node = &parent->n;
     }
     return rank;
