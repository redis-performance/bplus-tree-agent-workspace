+/* Return exactly the high bits of bytes equal to tag. This lookup mask
+ * needs no candidate-byte verification; the general scan mask is unchanged. */
+static inline uint64_t zbtIndexExactTagMask(uint64_t tags, uint8_t tag) {
+#if defined(__GNUC__) || defined(__clang__)
+    typedef uint8_t zbtTagVector __attribute__((vector_size(8)));
+    zbtTagVector bytes;
+    zbtTagVector query = {tag, tag, tag, tag, tag, tag, tag, tag};
+    memcpy(&bytes, &tags, sizeof(bytes));
+    zbtTagVector equal = bytes == query;
+    uint64_t mask;
+    memcpy(&mask, &equal, sizeof(mask));
+    return mask & UINT64_C(0x8080808080808080);
+#else
+    uint64_t x = tags ^ (UINT64_C(0x0101010101010101) * tag);
+    const uint64_t low = UINT64_C(0x7f7f7f7f7f7f7f7f);
+    return ~(((x & low) + low) | x | low);
+#endif
+}
