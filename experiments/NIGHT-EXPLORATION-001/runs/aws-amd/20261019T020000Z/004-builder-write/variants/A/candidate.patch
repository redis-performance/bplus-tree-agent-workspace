+/* Write a score using a new forward leaf's fixed encoding metadata. */
+static inline void zbtScoreWriteForward(unsigned char *data, unsigned int pos,
+                                       unsigned int bits, unsigned int score_shift,
+                                       uint64_t score_base, double score)
+{
+    if (bits == 0) return;
+    uint64_t delta = (zbtScoreToOrdered(score) - score_base) >> score_shift;
+    size_t bitpos = (size_t)pos * bits;
+    size_t byte = bitpos / 8;
+    unsigned int shift = bitpos & 7;
+    uint64_t word;
+    memcpy(&word, data + byte, sizeof(word));
+    word = intrev64ifbe(intrev64ifbe(word) | (delta << shift));
+    memcpy(data + byte, &word, sizeof(word));
+    if (shift && bits > 64 - shift)
+        data[byte + 8] |= delta >> (64 - shift);
+}
