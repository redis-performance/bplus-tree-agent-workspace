+/* Compare a leaf item, materializing its member only for a score tie. */
+static inline int zbtScoreLeafCompareAt(zbtScoreLeaf *leaf, unsigned int pos,
+                                       double score, const unsigned char *ele,
+                                       size_t elelen)
+{
+    double other = zbtScoreLeafScore(leaf, pos);
+    if (other < score) return -1;
+    if (other > score) return 1;
+    size_t len;
+    const unsigned char *member = zbtScoreLeafElement(leaf, pos, &len);
+    return zbtCompareElements(member, len, ele, elelen);
+}
