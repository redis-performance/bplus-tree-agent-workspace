+static void finish_pass(zbtreeSet *t,zbtreeDefragState *state){
+    unsigned count=0,limit=(unsigned)(8*t->length+t->next_score_leaf_id+8);
+    while(!step(t,state))CHECK(++count<=limit);passes++;
+}
+static uint64_t rng_state,mutation_count,active_mutations,active_steps,retirements,header_restarts;
+static uint64_t random64(void){uint64_t z=(rng_state+=UINT64_C(0x9e3779b97f4a7c15));z=(z^(z>>30))*UINT64_C(0xbf58476d1ce4e5b9);z=(z^(z>>27))*UINT64_C(0x94d049bb133111eb);return z^(z>>31);}
+static unsigned choose_live(void){unsigned id=(unsigned)(random64()%total),n=0;while(!live[id]){id=(id+1)%total;CHECK(++n<total);}return id;}
+static void update(zbtreeSet *t,unsigned turn){
+    const double values[]={-DBL_MAX,-DBL_MIN,-DBL_TRUE_MIN,-0.0,+0.0,DBL_TRUE_MIN,DBL_MIN,DBL_MAX};
