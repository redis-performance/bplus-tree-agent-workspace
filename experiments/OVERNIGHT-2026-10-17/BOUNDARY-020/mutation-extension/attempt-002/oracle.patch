+}
+static void *start_move(void *old){void *p=move_allocation(old);if(p){zfree(old);released++;}return p;}
+static void release_old(void *old){released++;zfree(old);}
+static void expected_add(void *p){CHECK(expected_n<LIMIT*2);for(unsigned i=0;i<expected_n;i++)CHECK(expected[i]!=(uintptr_t)p);expected[expected_n++]=(uintptr_t)p;}
+static void enumerate(zbtScoreNode *node){
+    if(!node)return;expected_add(node);
+    if(!node->isleaf){zbtScoreInner *inner=(zbtScoreInner *)node;for(unsigned i=0;i<node->count;i++)enumerate(inner->child[i]);}
+    else{zbtScoreLeaf *leaf=(zbtScoreLeaf *)node;for(unsigned i=0;i<node->count;i++){unsigned char *record=zbtScoreLeafRecord(leaf,i);if(record[0]==ZBT_PACKED_EXTERNAL)expected_add(zbtExternalPointer(record));}}
+}
+static int step(zbtreeSet *t,zbtreeDefragState *state){
+    zbtIndexRehash *rh=t->member_rehash;uint32_t cursor=rh?rh->next_leaf_id:0;uint16_t resize=rh?rh->resize_id:0;uint32_t rev=t->member_revision;
