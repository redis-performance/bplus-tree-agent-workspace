+    for(unsigned i=0;i<total;i++)CHECK(seen[i]==live[i]);
+    CHECK(t->member_rehash==rehash && (!rehash||rehash->next_leaf_id==next) && t->member_revision==revision && zbtreeAllocSize(t)==owned);
+    if(lookup){
+        for(unsigned i=0;i<total;i++){unsigned char buf[1024];size_t len=key(i,buf);double score;CHECK(zbtreeScoreRaw(t,buf,len,&score)==live[i]);if(live[i])CHECK(bits(score)==bits(scores[i]));}
+        for(unsigned j=0;j<n;j++){unsigned char buf[1024];size_t len=key(order[j],buf);sds s=sdsnewlen(buf,len);double score;
