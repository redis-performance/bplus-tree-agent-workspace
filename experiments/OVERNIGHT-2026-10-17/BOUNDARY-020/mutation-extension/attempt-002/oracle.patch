+}
+static void append(zbtreeSet *t){
+    CHECK(total<LIMIT);unsigned id=total++;unsigned char buf[1024];size_t len=key(id,buf);
+    double score=(double)((int)(id/4)-100);
+    if(score==0)score=(id&1)?-0.0:0.0;
+    scores[id]=score;live[id]=1;
+    if(stage==1)zbtreeInsertNewAppend(t,score,buf,len);else zbtreeInsertNewRaw(t,score,buf,len,NULL);
+}
+static unsigned uncopied(zbtreeSet *t){unsigned n=0;if(t->member_rehash)for(zbtScoreLeaf *p=t->score_first;p;p=p->next)n+=p->n.index_resize!=t->member_rehash->resize_id;return n;}
+static int64_t allocation_delta;
+static void *expected_first,*force_header;
+static int first_pending, track;
+static uintptr_t expected[LIMIT*2];
+static unsigned char visited[LIMIT*2];
+static unsigned expected_n,visited_n;
+static void *move_allocation(void *old){
+    CHECK(old);if(first_pending){CHECK(old==expected_first);first_pending=0;restarts++;}
+    if(track){unsigned i=0;while(i<expected_n && expected[i]!=(uintptr_t)old)i++;CHECK(i<expected_n && !visited[i]);visited[i]=1;visited_n++;}
