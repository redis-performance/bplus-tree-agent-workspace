cc -Isrc -Icompat -Ivendor/redis -std=c11 -g -Wall -Wextra -fno-omit-frame-pointer -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fsanitize=address,undefined bench/microbench.c src/zset_btree.c compat/standalone.c vendor/redis/siphash.c -lm -o build/sanitize/btree-bench
