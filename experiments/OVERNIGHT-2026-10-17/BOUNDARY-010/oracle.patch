--- /dev/null
+++ b/tests/raw_guard_oracle.c
@@ -0,0 +1,90 @@
+#define _DARWIN_C_SOURCE 1
+#define _GNU_SOURCE 1
+#include "server.h"
+#include "zset_btree.h"
+#include <sys/mman.h>
+#include <unistd.h>
+#include <float.h>
+#include <math.h>
+#include <inttypes.h>
+#ifndef MAP_ANONYMOUS
+#define MAP_ANONYMOUS MAP_ANON
+#endif
+static const size_t lengths[]={0,1,2,3,4,7,8,15,16,17,31,32,33,63,64,65,95,96,97,127,128,129,255,256,257,319,320,321,4095,4096,4097,65535,65536};
+#define N (sizeof(lengths)/sizeof(*lengths))
+static unsigned seed,alignment,stage;
+static size_t length_now;
+static unsigned long mappings,checks,queries;
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"seed=%u alignment=%u stage=%u length=%zu line=%d: %s\n",seed,alignment,stage,length_now,__LINE__,#x);abort();}}while(0)
+static uint64_t bits(double x){uint64_t u;memcpy(&u,&x,8);return u;}
+typedef struct {unsigned char *base,*ptr;size_t total,body;} guarded;
+static guarded make_guard(size_t len,unsigned right){
+    long pagesize=sysconf(_SC_PAGESIZE);CHECK(pagesize>0);size_t page=(size_t)pagesize;
+    size_t body=((len?len:1)+page-1)/page*page,total=body+2*page;
+    unsigned char *base=mmap(NULL,total,PROT_NONE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+    CHECK(base!=MAP_FAILED);CHECK(mprotect(base+page,body,PROT_READ|PROT_WRITE)==0);
+    unsigned char *p=right?base+page+body-len:base+page;
+    mappings++;return (guarded){base,p,total,body};
+}
+static void protect(guarded *g,int prot){
+    size_t page=(g->total-g->body)/2;CHECK(mprotect(g->base+page,g->body,prot)==0);
+}
+static void release(guarded *g){CHECK(munmap(g->base,g->total)==0);}
+static int cmp(const void *ap,const void *bp);
+static sds keys[N];static double values[N];
+static int cmp(const void *ap,const void *bp){
+    unsigned a=*(const unsigned*)ap,b=*(const unsigned*)bp;
+    if(values[a]<values[b])return -1;if(values[a]>values[b])return 1;
+    size_t na=sdslen(keys[a]),nb=sdslen(keys[b]);int c=memcmp(keys[a],keys[b],na<nb?na:nb);
+    return c?c:(na>nb)-(na<nb);
+}
+static void verify(zbtreeSet *tree){
+    CHECK(zbtreeLength(tree)==N);unsigned order[N];
+    for(unsigned i=0;i<N;i++){
+        double score;CHECK(zbtreeScore(tree,keys[i],&score));CHECK(bits(score)==bits(values[i]));order[i]=i;
+    }
+    qsort(order,N,sizeof(*order),cmp);
+    for(int reverse=0;reverse<2;reverse++){
+        zbtreeIterator it;CHECK(zbtreeIteratorStart(tree,reverse,&it));
+        for(unsigned j=0;j<N;j++){
+            unsigned i=order[reverse?N-j-1:j];const unsigned char *ele;size_t len;double score;
+            CHECK(zbtreeIteratorNext(&it,reverse,&ele,&len,&score));CHECK(len==sdslen(keys[i]));
+            CHECK(!memcmp(ele,keys[i],len) && bits(score)==bits(values[i]));
+        }
+        CHECK(!zbtreeIteratorNext(&it,reverse,NULL,NULL,NULL));
+    }
+    checks++;
+}
+static void exercise(void){
+    uint8_t hs[16]={0};hs[0]=seed;dictSetHashFunctionSeed(hs);
+    double scores[]={-0.0,0.0,-DBL_MAX,DBL_MAX,-DBL_TRUE_MIN,DBL_TRUE_MIN,nextafter(1.0,2.0)};
+    zbtreeSet *tree=zbtreeCreate();guarded buffers[N];stage=0;
+    for(unsigned i=0;i<N;i++){
+        size_t len=length_now=lengths[i];guarded g=make_guard(len,alignment);
+        for(size_t j=0;j<len;j++)g.ptr[j]=(unsigned char)((j*17+3)%256);
+        keys[i]=sdsnewlen(g.ptr,len);values[i]=scores[i%7];buffers[i]=g;
+        double old;zbtreeInsertPosition pos;CHECK(!zbtreeFindForAdd(tree,keys[i],&old,&pos));
+        protect(&buffers[i],PROT_READ);
+        zbtreeInsertNewRaw(tree,values[i],g.ptr,len,i%2?&pos:NULL);
+        double actual;CHECK(zbtreeScoreRaw(tree,g.ptr,len,&actual));CHECK(bits(actual)==bits(values[i]));queries++;
+        CHECK(zbtreeScoreRaw(tree,g.ptr,len,NULL));queries++;
+    }
+    stage=1;verify(tree);
+    for(unsigned i=0;i<N;i++){
+        length_now=lengths[i];double actual;
+        CHECK(zbtreeScoreRaw(tree,buffers[i].ptr,length_now,&actual));CHECK(bits(actual)==bits(values[i]));queries++;
+        if(length_now){
+            guarded missing=make_guard(length_now,alignment);memcpy(missing.ptr,keys[i],length_now);missing.ptr[0]^=0x80;
+            protect(&missing,PROT_READ);CHECK(!zbtreeScoreRaw(tree,missing.ptr,length_now,&actual));queries++;
+            CHECK(!zbtreeScoreRaw(tree,missing.ptr,length_now,NULL));queries++;release(&missing);
+        }
+        protect(&buffers[i],PROT_READ|PROT_WRITE);if(length_now)memset(buffers[i].ptr,0xa5,length_now);release(&buffers[i]);
+    }
+    stage=2;verify(tree);zbtreeSet *copy=zbtreeDup(tree);zbtreeFree(tree);tree=copy;stage=3;verify(tree);
+    zbtreeFree(tree);for(unsigned i=0;i<N;i++)sdsfree(keys[i]);
+    printf("seed=%u alignment=%u PASS lengths=%zu mappings=%lu queries=%lu checks=%lu\n",seed,alignment,(size_t)N,mappings,queries,checks);fflush(stdout);
+}
+int main(void){
+    unsigned seeds[]={17,101};for(unsigned s=0;s<2;s++){seed=seeds[s];for(alignment=0;alignment<2;alignment++)exercise();}
+    printf("PASS fixtures=4 lengths=%zu mappings=%lu queries=%lu checks=%lu\n",(size_t)N,mappings,queries,checks);
+}
