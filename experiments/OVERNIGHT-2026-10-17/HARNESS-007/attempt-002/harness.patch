+#define _DARWIN_C_SOURCE 1
+#define _POSIX_C_SOURCE 200809L
+#include "server.h"
+#include "zset_btree.h"
+#include <inttypes.h>
+#include <string.h>
+#include <time.h>
+#include <errno.h>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <pthread/qos.h>
