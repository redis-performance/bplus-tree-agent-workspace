+                           ele, elelen, score, score_leaf, score_pos,
+                           found_bucket, found_pos))
+        return 1;
+    return zbtIndexTableFindContinue(zs, table, hash, ele, elelen, score,
+                                     score_leaf, score_pos, found_bucket,
+                                     found_pos, insert_bucket, insert_pos);
