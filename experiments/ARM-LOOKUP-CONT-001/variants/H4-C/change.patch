+/* Successful home-bucket hits return without entering the filter/probe
+ * continuation. Inline so unused lookup outputs still disappear. */
+static inline __attribute__((always_inline))
+int zbtIndexTableFind(zbtreeSet *zs, zbtIndexTable *table,
+                             uint32_t hash, const unsigned char *ele,
