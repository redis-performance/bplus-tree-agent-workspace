+                             zbtIndexBucket **found_bucket,
+                             unsigned int *found_pos,
+                             zbtIndexBucket **insert_bucket,
+                             unsigned int *insert_pos)
+{
+    if (table->size == 0) return 0;
+    zbtIndexBucket *bucket = zbtIndexBucketAt(table, hash & (table->size - 1));
