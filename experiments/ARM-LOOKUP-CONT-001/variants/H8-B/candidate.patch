+/* Decode a lookup candidate, rejecting an external hash mismatch before
+ * reading or validating its pointer. Ordinary inline headers form the full
+ * range 0..253; the two remaining values retain their packed representation.
+ * Rejection leaves both output arguments unchanged. */
+static inline int zbtPackedLookupData(const unsigned char *record,
+                                     uint32_t hash,
+                                     const unsigned char **data, size_t *len)
+{
+    unsigned int header = record[0];
+    if (header < ZBT_PACKED_SHORT) {
+        *len = header;
+        *data = record + 1;
+    } else if (header == ZBT_PACKED_SHORT) {
+        uint16_t shortlen;
+        memcpy(&shortlen, record + 1, sizeof(shortlen));
+        *len = shortlen;
+        *data = record + 3;
+    } else {
+        if (zbtExternalHash(record) != hash) return 0;
+        unsigned char *ptr = zbtExternalPointer(record);
+        serverAssert(ptr != NULL);
+        *len = zbtExternalLength(record);
+        *data = ptr;
+    }
+    return 1;
+}
