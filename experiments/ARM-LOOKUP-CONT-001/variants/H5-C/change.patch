+/* Stable lookup needs only the current table. Keep every optional output
+ * and insertion-hint convention of the generic dispatcher. */
+static inline __attribute__((always_inline))
+int zbtIndexFind(zbtreeSet *zs, uint32_t hash,
+                        const unsigned char *ele, size_t elelen,
+                        double *score,
+                        zbtScoreLeaf **found_score_leaf,
+                        unsigned int *found_score_position,
+                        zbtIndexBucket **found_bucket,
+                        unsigned int *found_bucket_position)
+{
+    if (zs->member_rehash == NULL) {
+        zbtIndexBucket *bucket = NULL, *hint_bucket = NULL;
+        unsigned int pos = 0, hint_pos = 0;
+        int found = zbtIndexTableFind(zs, &zs->member_index, hash, ele, elelen,
+                                      score, found_score_leaf,
+                                      found_score_position,
+                                      found_bucket ? &bucket : NULL,
+                                      found_bucket_position ? &pos : NULL,
+                                      found_bucket ? &hint_bucket : NULL,
+                                      found_bucket ? &hint_pos : NULL);
+        if (found_bucket) *found_bucket = found ? bucket : hint_bucket;
+        if (found_bucket_position) *found_bucket_position = found ? pos : hint_pos;
+        return found;
+    }
+    return zbtIndexFindResizing(zs, hash, ele, elelen, score,
+                                found_score_leaf, found_score_position,
+                                found_bucket, found_bucket_position);
+}
