+/* Record descriptors retain a 12-bit byte offset. A nonzero upper nibble
+ * is one plus the length of a physically inline member of length 0..14. */
+_Static_assert(ZBT_SCORE_LEAF_BYTES <= 0x0fff, "record offset fits 12 bits");
+static inline uint16_t zbtRecordOffset(uint16_t descriptor) {
+    return descriptor & 0x0fff;
+}
+
+static inline unsigned int zbtRecordLengthCode(uint16_t descriptor) {
+    return descriptor >> 12;
+}
+
+/* The record must have been written before its descriptor is encoded. */
+static inline uint16_t zbtScoreLeafEncodeOffset(zbtScoreLeaf *leaf,
+                                               size_t offset)
+{
+    serverAssert(offset <= ZBT_SCORE_LEAF_BYTES);
+    unsigned char marker = ((unsigned char *)leaf)[offset];
+    unsigned int code = marker < 15 ? marker + 1 : 0;
+    return (uint16_t)offset | (uint16_t)(code << 12);
+}
+
+/* Moving record bytes changes only the address portion of the descriptor. */
+static inline uint16_t zbtRecordRelocate(uint16_t descriptor, size_t offset) {
+    serverAssert(offset <= ZBT_SCORE_LEAF_BYTES);
+    return (descriptor & 0xf000) | (uint16_t)offset;
+}
+
+static inline uint16_t zbtScoreLeafDescriptor(zbtScoreLeaf *leaf,
+                                              unsigned int pos)
+{
+    uint16_t descriptor =
+        zbtScoreLeafOffsets(leaf)[zbtScoreLeafPhysicalPos(leaf, pos)];
+    debugServerAssert(!zbtRecordLengthCode(descriptor) ||
+        ((unsigned char *)leaf)[zbtRecordOffset(descriptor)] ==
+            zbtRecordLengthCode(descriptor) - 1);
+    return descriptor;
+}
+
 /* Return the member record offset stored at logical position 'pos'. */
