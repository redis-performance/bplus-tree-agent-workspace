+/* Set only the high bits of bytes equal to tag. Each unsigned byte of x &
+ * low has value 0..127, so adding 127 produces 127..254 without a carry into
+ * the next byte. Its high bit stays clear only for a zero low-seven-bit
+ * value; OR with x also excludes bytes whose original high bit was set.
+ * OR with low clears every non-high bit after the complement. */
+static inline uint64_t zbtIndexExactTagMask(uint64_t tags, uint8_t tag) {
+    const uint64_t low = UINT64_C(0x7f7f7f7f7f7f7f7f);
+    uint64_t x = tags ^ (UINT64_C(0x0101010101010101) * tag);
+    return ~(((x & low) + low) | x | low);
+}
