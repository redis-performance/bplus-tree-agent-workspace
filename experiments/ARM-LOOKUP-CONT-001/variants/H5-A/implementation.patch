+/* Keep resize progress and the two-table search outside stable raw reads.
+ * The generic finder reloads resize state after its step, which can finish
+ * the resize and release the old state. */
+static __attribute__((noinline))
+int zbtIndexReadResizing(zbtreeSet *zs, uint32_t hash,
+                         const unsigned char *ele, size_t elelen,
+                         double *score)
+{
+    return zbtIndexFind(zs, hash, ele, elelen, score,
+                        NULL, NULL, NULL, NULL);
+}
+
+static inline __attribute__((always_inline))
+int zbtIndexReadRaw(zbtreeSet *zs, uint32_t hash,
+                    const unsigned char *ele, size_t elelen, double *score)
+{
+    if (zs->member_rehash)
+        return zbtIndexReadResizing(zs, hash, ele, elelen, score);
+    return zbtIndexTableFind(zs, &zs->member_index, hash, ele, elelen, score,
+                             NULL, NULL, NULL, NULL, NULL, NULL);
+}
+
