+/* Return only true matching bytes, allowing lookup to consume each bit
+ * without rechecking its tag. Low seven bits plus 127 cannot carry between
+ * bytes; OR with x also rejects bytes whose original high bit was set. */
+static inline uint64_t zbtIndexExactTagMask(uint64_t tags, uint8_t tag) {
+    uint64_t x = tags ^ (UINT64_C(0x0101010101010101) * tag);
+    uint64_t low = UINT64_C(0x7f7f7f7f7f7f7f7f);
+    return ~(((x & low) + low) | x | low);
+}
