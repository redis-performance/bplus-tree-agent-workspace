+def check_export_container(info,cid,name,image,labels):
+    require(re.fullmatch('[0-9a-f]{64}',cid) is not None and info['Id']==cid and
+            info['Name']=='/'+name and info['Image']==image,'Export container ID/name/image differs')
+    actual=info['Config'].get('Labels') or {}
+    require(all(actual.get(k)==v for k,v in labels.items()),'Export container ownership differs')
+    state=info['State'];host=info['HostConfig']
+    require(state['Status']=='created' and state['Running'] is False and type(state['Pid']) is int and state['Pid']==0,
+            'Export container was started')
+    require(host['NetworkMode']=='none' and host['ReadonlyRootfs'] is True and
+            host['CapDrop']==['ALL'] and not host.get('CapAdd') and not info['Mounts'] and
+            info['Path']=='/bin/true' and not info['Args'],'Unexpected export container privileges/command/mounts')
+
+
+def receipt_inventory(destination):
+    """Host lstat inventory; preserve source ownership with docker cp -a, no -L."""
+    destination=Path(destination)
+    require(all((destination/name).exists() for name in RECEIPT_ITEMS),'Incomplete copied receipt items')
+    require((destination/'package-archives.sha256').stat().st_size>0,'Empty downloaded-package hash receipt')
+    require(all((destination/'apt-lists'/name).is_dir() for name in ('partial','auxfiles')),
+            'Required apt partial/auxfiles directory omitted')
+    entries=[]
+    for path in sorted(destination.rglob('*')):
+        st=path.lstat();row=dict(path=str(path.relative_to(destination)),uid=st.st_uid,gid=st.st_gid,
+                               mode=stat.S_IMODE(st.st_mode),size=st.st_size)
+        if stat.S_ISREG(st.st_mode):row.update(kind='file',sha256=sha(path))
+        elif stat.S_ISDIR(st.st_mode):row.update(kind='directory')
+        elif stat.S_ISLNK(st.st_mode):row.update(kind='symlink',target=os.readlink(path))
+        else:raise ValueError('Unexpected special file in apt receipts')
+        entries.append(row)
+    return entries
